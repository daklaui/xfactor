@model xfactor.Models.TR_LIST_VAL

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

<div class="form-horizontal">

    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.ID_LIST_VAL)

    <div class="form-group">
        <div class="col-md-10">
            @Html.Label("Commentaire", htmlAttributes: new { @class = "control-label" })

            @Html.EditorFor(model => model.COM_LIST_VAL, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.COM_LIST_VAL, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-10">
            @Html.Label("Nombre de jours", htmlAttributes: new { @class = "control-label" })

            @Html.EditorFor(model => model.NB_JOUR_LIST_VAL, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.NB_JOUR_LIST_VAL, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-10">
            @Html.Label("Type", htmlAttributes: new { @class = "control-label" })

            <select name="TYPE_RECOUVREMENT" class="form-control">
                <option value="APPEL">APPELE TELE</option>
                <option value="SEND_MAIL">SEND_MAIL</option>
            </select>
            @Html.ValidationMessageFor(model => model.TYPE_RECOUVREMENT, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Modifier" class="btn btn-primary pull-right" />
        </div>
    </div>

</div>
}

